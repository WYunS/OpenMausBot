ARG BASE_IMAGE=docker.io/trycua/xfce-cua@sha256:274eb636f5cf3fc58f705916ee72b7a701270b3877369d08533a385c5325be9b
FROM ${BASE_IMAGE}

USER root

ARG CUA_DRIVER_VERSION=0.20.0
ARG IMAGE_LAYER_VERSION=6
ARG CUA_WHEEL_AMD64_URL=https://files.pythonhosted.org/packages/fa/d7/a43008a328a40c85e7bc706fc20235b9abedc75e28b413817655153157ff/cua_driver-0.20.0-py3-none-manylinux_2_31_x86_64.whl
ARG CUA_WHEEL_AMD64_SHA256=f60c35696a37f37ac954935e478ae4754f220856d022036625c9400d72185961
ARG CUA_WHEEL_ARM64_URL=https://files.pythonhosted.org/packages/94/9d/1c1838b69067e83266c3d2aae02d74eef353a43dc8644884ccf03fe7f933/cua_driver-0.20.0-py3-none-manylinux_2_31_aarch64.whl
ARG CUA_WHEEL_ARM64_SHA256=48833bc5e4c60e701fc9eefb57dbac36ec77ef3990f816fbbe85b4e954af2c77
ARG APT_DEBIAN_MIRROR
ARG APT_SECURITY_MIRROR
ARG REQUIRE_ENTERPRISE_APPS=0
ARG FEISHU_DEB_SHA256
ARG FEILIAN_DEB_SHA256

RUN set -eux; \
    if [ -n "$APT_DEBIAN_MIRROR" ]; then \
      find /etc/apt -type f -name '*.list' -o -name '*.sources' | xargs sed -i "s|http://deb.debian.org/debian|$APT_DEBIAN_MIRROR|g"; \
    fi; \
    if [ -n "$APT_SECURITY_MIRROR" ]; then \
      find /etc/apt -type f -name '*.list' -o -name '*.sources' | xargs sed -i "s|http://deb.debian.org/debian-security|$APT_SECURITY_MIRROR|g"; \
    fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      fontconfig fonts-noto-cjk fonts-noto-color-emoji locales ibus ibus-libpinyin; \
    if apt-cache show language-pack-zh-hans >/dev/null 2>&1; then \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends language-pack-zh-hans; \
    fi; \
    printf '\npath-include /usr/share/locale/zh_CN/**\n' >> /etc/dpkg/dpkg.cfg.d/docker; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --reinstall --no-install-recommends \
      xfce4-appfinder xfce4-panel xfce4-session xfce4-settings xfce4-terminal \
      thunar thunar-data xfdesktop4 xfdesktop4-data \
      libxfce4ui-common libxfce4util-common libgarcon-common; \
    sed -i 's/^# *zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen; \
    locale-gen zh_CN.UTF-8; \
    printf 'LANG=zh_CN.UTF-8\nLANGUAGE=zh_CN:zh\nLC_CTYPE=zh_CN.UTF-8\n' > /etc/default/locale; \
    install -d -o cua -g cua /home/cua/.config/environment.d; \
    printf 'LANG=zh_CN.UTF-8\nLANGUAGE=zh_CN:zh\nLC_CTYPE=zh_CN.UTF-8\nGTK_IM_MODULE=ibus\nQT_IM_MODULE=ibus\nXMODIFIERS=@im=ibus\n' > /home/cua/.config/environment.d/10-openmausbot-zh.conf; \
    chown cua:cua /home/cua/.config/environment.d/10-openmausbot-zh.conf; \
    rm -rf /var/lib/apt/lists/*; \
    fc-cache -f; \
    test "$(fc-list :lang=zh | wc -l)" -gt 0; \
    locale -a | grep -qi '^zh_CN\.utf8$'; \
    test -s /usr/share/locale/zh_CN/LC_MESSAGES/xfce4-panel.mo; \
    test -s /usr/share/locale/zh_CN/LC_MESSAGES/thunar.mo

# Keep browser defaults correct in the immutable image. Runtime startup also
# re-asserts these policies so older preserved containers receive the fix.
RUN set -eux; \
    install -d -m 0755 /etc/opt/chrome/policies/managed /etc/chromium/policies/managed /usr/lib/firefox-esr/distribution; \
    printf '%s\n' '{"DefaultSearchProviderEnabled":true,"DefaultSearchProviderName":"Bing","DefaultSearchProviderKeyword":"bing.com","DefaultSearchProviderSearchURL":"https://www.bing.com/search?q={searchTerms}","DefaultSearchProviderSuggestURL":"https://www.bing.com/osjson.aspx?query={searchTerms}"}' \
      > /etc/opt/chrome/policies/managed/openmausbot-search.json; \
    cp /etc/opt/chrome/policies/managed/openmausbot-search.json /etc/chromium/policies/managed/openmausbot-search.json; \
    printf '%s\n' '{"policies":{"SearchEngines":{"Default":"Bing"}}}' > /usr/lib/firefox-esr/distribution/policies.json

# Feishu publishes Linux clients, while Feilian enterprise packages may be
# tenant-scoped. Reviewed packages are supplied out-of-band under vendor/ and
# are never fetched from an unpinned "latest" URL. Production image builds can
# require both; source/development builds remain usable without private files.
COPY vendor/ /tmp/openmausbot-vendor/
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    feishu="/tmp/openmausbot-vendor/feishu-${arch}.deb"; \
    feilian="/tmp/openmausbot-vendor/feilian-${arch}.deb"; \
    if [ "$REQUIRE_ENTERPRISE_APPS" = 1 ]; then \
      test -n "$FEISHU_DEB_SHA256"; test -n "$FEILIAN_DEB_SHA256"; \
      test -s "$feishu"; test -s "$feilian"; \
      echo "$FEISHU_DEB_SHA256  $feishu" | sha256sum -c -; \
      echo "$FEILIAN_DEB_SHA256  $feilian" | sha256sum -c -; \
      test "$(dpkg-deb -f "$feishu" Architecture)" = "$arch"; \
      test "$(dpkg-deb -f "$feilian" Architecture)" = "$arch"; \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$feishu" "$feilian"; \
      rm -rf /var/lib/apt/lists/*; \
    fi; \
    rm -rf /tmp/openmausbot-vendor

RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) wheel_url="$CUA_WHEEL_AMD64_URL"; wheel_sha="$CUA_WHEEL_AMD64_SHA256"; wheel_path="/tmp/cua_driver-${CUA_DRIVER_VERSION}-py3-none-manylinux_2_31_x86_64.whl"; lib_triplet=x86_64-linux-gnu ;; \
      aarch64|arm64) wheel_url="$CUA_WHEEL_ARM64_URL"; wheel_sha="$CUA_WHEEL_ARM64_SHA256"; wheel_path="/tmp/cua_driver-${CUA_DRIVER_VERSION}-py3-none-manylinux_2_31_aarch64.whl"; lib_triplet=aarch64-linux-gnu ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    for ssl_lib in "/lib/$lib_triplet/libssl.so.3" "/lib/$lib_triplet/libcrypto.so.3"; do \
      if [ -e "$ssl_lib" ] && [ ! -s "$ssl_lib" ]; then \
        echo "pinned base image is defective on $arch: $ssl_lib is zero bytes" >&2; exit 1; \
      fi; \
    done; \
    curl -fsSL "$wheel_url" -o "$wheel_path"; \
    echo "$wheel_sha  $wheel_path" | sha256sum -c -; \
    /opt/venv/bin/python -m pip install --no-cache-dir --force-reinstall --no-deps "$wheel_path"; \
    rm -f "$wheel_path"; \
    driver_bin="$(find /opt/venv/lib -path '*/cua_driver/bin/cua-driver' -type f -print -quit)"; \
    test -n "$driver_bin"; \
    install -D -m 0755 "$driver_bin" /usr/local/libexec/openmausbot/cua-driver; \
    install -d -o cua -g cua -m 0700 /home/cua/workspace; \
    test "$(/usr/local/libexec/openmausbot/cua-driver --version)" = "cua-driver ${CUA_DRIVER_VERSION}"

COPY prepare-workspace.sh /usr/local/bin/prepare-openmausbot-workspace.sh
COPY start-cua-driver.sh /usr/local/bin/start-openmausbot-cua-driver.sh
COPY supervisor-cua-driver.conf /tmp/openmausbot-cua-driver.conf
RUN chmod 0755 /usr/local/bin/prepare-openmausbot-workspace.sh /usr/local/bin/start-openmausbot-cua-driver.sh \
    && cat /tmp/openmausbot-cua-driver.conf >> /etc/supervisor/supervisord.conf \
    && rm /tmp/openmausbot-cua-driver.conf

LABEL com.openmausbot.local-vm="1" \
      com.openmausbot.cua-driver="${CUA_DRIVER_VERSION}" \
      com.openmausbot.cua-base="sha256:274eb636f5cf3fc58f705916ee72b7a701270b3877369d08533a385c5325be9b" \
      com.openmausbot.image-layer="${IMAGE_LAYER_VERSION}" \
      org.opencontainers.image.title="OpenMausBot Chinese Cua desktop" \
      org.opencontainers.image.vendor="OpenMausBot"
